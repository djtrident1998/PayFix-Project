    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst b = $input.first().json.body;\nreturn [{ json: {\n  ticket_id: 'DSP-' + Date.now(),\n  created_at: new Date().toISOString(),\n  customer_name: b.name,\n  email: b.email,\n  payment_id: (b.payment_id || '').trim(),\n  issue_type: b.issue_type,\n  complaint_text: b.complaint_text\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        224
      ],
      "id": "ae78388e-9969-4ca3-98a9-5a570d286265",
      "name": "Make Ticket"
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst p = $input.first().json;\nconst found = p && p.id && !p.error;\nconst days = found ? Math.floor((Date.now() / 1000 - p.created_at) / 86400) : null;\nreturn [{ json: {\n  payment_found: !!found,\n  payment_status: found ? p.status : 'not_found',\n  amount_inr: found ? p.amount / 100 : 0,\n  amount_refunded_inr: found ? (p.amount_refunded || 0) / 100 : 0,\n  method: found ? p.method : '',\n  vpa: found ? (p.vpa || '') : '',\n  payment_date: found ? new Date(p.created_at * 1000).toISOString() : '',\n  days_since_payment: days\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        224
      ],
      "id": "7349c0e2-64cd-4d9a-87e1-9bea3e50bbfd",
      "name": "Prepare Payment"
    },
    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst t = $('Make Ticket').first().json;\nconst a = $input.first().json.output;\nconst statusMap = { auto_refund: 'refund_pending', escalate: 'with_analyst', reject: 'rejected' };\nreturn [{ json: {\n  ticket_id: t.ticket_id,\n  created_at: t.created_at,\n  customer_name: t.customer_name,\n  email: t.email,\n  payment_id: t.payment_id,\n  complaint_text: t.complaint_text,\n  payment_status: a.payment_status,\n  amount_inr: a.amount_inr,\n  dispute_type: a.dispute_type,\n  policy_rule_used: a.policy_rule_used,\n  decision: a.decision,\n  reason: a.reason,\n  refund_id: '',\n  assigned_to: a.assigned_to,\n  status: statusMap[a.decision] || 'with_analyst',\n  customer_message: a.customer_message\n}}];"
      },
